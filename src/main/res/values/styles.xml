<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the forwarding Activity: normal settings and recovery screens retain their own UI. -->
    <style name="HomeProxyTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#0F1723</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/HomeProxyNoAnimation</item>
    </style>
    <style name="HomeProxyNoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
</resources>
